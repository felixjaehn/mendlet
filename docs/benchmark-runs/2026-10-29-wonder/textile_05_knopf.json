 "guide": {
  "steps": [
   {
    "n": 1,
    "title": "Schadstelle prüfen und ausrichten",
    "text": "Hemd mit der Außenseite nach oben flach hinlegen. Schadstelle in der Mitte zwischen den zwei noch vorhandenen Knöpfen suchen: weiße Fadenreste und 4 kleine Löcher. Stoff um die Stelle leicht glatt streichen. Ziel erreicht, wenn die vier alten Einstichlöcher frei liegen.",
    "common_mistake": "Alte harte Knoten drin lassen – der neue Knopf sitzt dann schief und wackelt.",
    "safety_critical": false,
    "requires_confirmation": false,
    "segment_ids": [
     "seg_1"
    ],
    "uses_items": [],
    "overlay": {
     "type": "highlight",
     "stitch_type": null,
     "segment_id": "seg_1",
     "from_segment_id": null,
     "to_segment_id": null,
     "hold_seconds": null
    }
   },
   {
    "n": 2,
    "title": "Alte Fadenreste entfernen",
    "text": "Mit der kleinen Schere nur die losen weißen Fadenreste bündig abschneiden. Schere flach halten, Spitze vom Stoff weg, keine Gewebefäden durchtrennen. Alte Knotenreste vorsichtig herauszupfen. Schutz: Finger weg von der Schneide, Schere nach Gebrauch sofort schließen und weglegen. Ziel erreicht, wenn die Stelle flach ist und keine dicken Knoten mehr fühlbar sind.",
    "common_mistake": "Mit Gewalt ziehen – dabei wird das feine Hemdgewebe aufgerissen.",
    "safety_critical": true,
    "requires_confirmation": true,
    "segment_ids": [
     "seg_1"
    ],
    "uses_items": [
     "schere"
    ],
    "overlay": null
   },
   {
    "n": 3,
    "title": "Garn und Ersatzknopf vorbereiten",
    "text": "Etwa 50 cm weißes Garn abschneiden, doppelt in die feine Handnadel einfädeln und die beiden Enden mit kleinem Knoten verbinden. Ersatzknopf in Größe und Farbe mit den Nachbarknöpfen vergleichen und mittig auf die vier alten Einstichpunkte legen. Ziel erreicht, wenn Nadel startbereit ist und der Knopf mittig auf der Leiste liegt.",
    "common_mistake": "Zu langer Faden – verknotet sich ständig und wird fusselig.",
    "safety_critical": false,
    "requires_confirmation": false,
    "segment_ids": [],
    "uses_items": [
     "nadel",
     "garn",
     "knopf"
    ],
    "overlay": null
   },
   {
    "n": 4,
    "title": "Knopf mit Stiel annähen",
    "text": "Von der Rückseite der Knopfleiste in ein altes Einstichloch einstechen und vorne durch ein Knopfloch austreten, dann kreuzweise durch die gegenüberliegenden Knopflöcher und Stofflöcher nähen, wie bei den Nachbarknöpfen als Kreuz. Faden locker lassen, etwa 2-3 mm Abstand zwischen Knopf und Stoff als Stiel lassen, z. B. mit einem Streichholz unter dem Knopf. 6-8 Durchgänge machen. Ziel erreicht, wenn der Knopf im Kreuzmuster fest, aber beweglich mit Stiel sitzt.",
    "common_mistake": "Knopf platt ohne Abstand annähen – dann lässt er sich kaum knöpfen und spannt.",
    "safety_critical": false,
    "requires_confirmation": false,
    "segment_ids": [
     "seg_1"
    ],
    "uses_items": [
     "nadel",
     "garn",
     "knopf"
    ],
    "overlay": null
   },
   {
    "n": 5,
    "title": "Wickeln, sichern und prüfen",
    "text": "Faden 4-5-mal fest um den entstandenen Stiel zwischen Knopf und Stoff wickeln, dann auf der Rückseite mit 2-3 kleinen Stichen im festen Stoff vernähen und erst dann mit der kleinen Schere bündig abschneiden. Schutz: beim Schneiden Stoff weghalten, Schere sicher ablegen. Zum Schluss Knopfprobe durch das gegenüberliegende Knopfloch: schließt glatt, kein Kräuseln, kein Ausreißen. Bei Lockerheit nicht weiter benutzen, sondern neu sichern.",
    "common_mistake": "Faden direkt am Knoten abschneiden – die Sicherung geht wieder auf.",
    "safety_critical": true,
    "requires_confirmation": true,
    "segment_ids": [
     "seg_1"
    ],
    "uses_items": [
