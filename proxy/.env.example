META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
DAILY_BUDGET_USD=5
# Empty = mock mode when META_API_KEY is unset, real mode otherwise. 1 = force mock, 0 = force real.
MOCK_MODE=
# 1 = cache real model calls under proxy/.cache (never re-spend credits in tests/benchmark)
CACHE_MODEL_CALLS=1
HOST=0.0.0.0
PORT=8787
# off (default) = classic pipeline, wonder = Muse Wonder tool-calling agent
AGENT_MODE=
