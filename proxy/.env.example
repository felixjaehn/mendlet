# Copy to .env. Real environment variables take precedence over this file.

# Meta Model API key. Leave empty to run in mock mode (no network, deterministic fixtures).
META_API_KEY=
# Base URL of the Meta Model API (OpenAI-compatible).
META_BASE_URL=https://api.meta.ai/v1

# Model IDs.
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
IMAGE_MODEL=muse-image-1.0
TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
WONDER_MODEL=muse-wonder-1.0

# Reasoning effort for Spark and for the Wonder agent (minimal, low, medium, high, max).
MUSE_REASONING_EFFORT=low
WONDER_REASONING_EFFORT=minimal
# Upper bound for Spark completion tokens per call.
MUSE_MAX_COMPLETION_TOKENS=16000

# Empty = mock when META_API_KEY is unset, real otherwise. 1 = force mock, 0 = force real.
MOCK_MODE=
# Scales the simulated latency in mock mode (0 = instant).
MOCK_DELAY_SCALE=1.0

# off (default) = classic pipeline, wonder = Muse Wonder tool-calling agent.
AGENT_MODE=off

# Daily spend limit in USD; requests are rejected with 429 once it is reached.
DAILY_BUDGET_USD=5
# 1 = cache real model calls on disk so tests and benchmarks never re-spend credits.
CACHE_MODEL_CALLS=1
# Cache location (default: proxy/.cache).
CACHE_DIR=
# Directory with the prompt files (default: ../prompts).
PROMPTS_DIR=
