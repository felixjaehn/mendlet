{
  "sourceLanguage": "de",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reparatur-Assistent"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repair Assistant"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera erkennt Schäden im Live-Bild, nimmt ein Foto auf und zeigt Stichpunkte auf dem Stoff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera detects damage in the live image, takes a photo and shows stitch points on the fabric."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon wird genutzt, um den Schaden per Sprache zu beschreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is used to describe the damage by voice."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf deine Fotos erlaubt dir, ein vorhandenes Bild des Schadens auszuwählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access to your photos lets you pick an existing picture of the damage."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App verbindet sich mit dem Analyse-Server in deinem lokalen Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app connects to the analysis server on your local network."
          }
        }
      }
    }
  },
  "version": "1.0"
}
